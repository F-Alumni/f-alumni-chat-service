        <mxCell id="title" value="FPT ALUMNI CONNECT — SYSTEM ARCHITECTURE (.NET 10 MICROSERVICES)&#xa;Designed by Trương Chí Trung (BE1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1440" height="60" as="geometry" />
        </mxCell>
        <!-- Clients -->
        <mxCell id="webClient" value="Web Client&#xa;(React 18 + Vite + TS)&#xa;REST + SignalR WSS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mobileClient" value="Mobile App&#xa;(Flutter Cross-Platform)&#xa;REST + SignalR WSS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="adminPortal" value="Admin Web Portal&#xa;(Moderation &amp; Dashboard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="110" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pingerBot" value="Render 60s Pinger Bot&#xa;GET /ping &amp; /health every 60s&#xa;(Zero Cold Start)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="110" width="300" height="60" as="geometry" />
        </mxCell>
        <!-- API Gateway -->
        <mxCell id="apiGateway" value="YARP API GATEWAY (Reverse Proxy :5000 / Render HTTPS)&#xa;Single Entrypoint • Route Rewrite (/api/users/*, /api/chat/*, /api/forum/*, /api/ai/*, /api/admin/*) • JWT Pass-through • SignalR Proxy (/hubs/chat)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=#1e40af;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="1440" height="70" as="geometry" />
        </mxCell>
        <!-- Services -->
        <mxCell id="userSvc" value="USER SERVICE (BE1 - Chí Trung)&#xa;Port: 5001 / 8080&#xa;• Auth, OTP, Google OAuth, JWT&#xa;• Alumni Directory &amp; Privacy&#xa;• Block Users &amp; Calendar Link&#xa;• gRPC Server (UserProfileService)&#xa;• Kafka Producer (user.registered.v1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="chatSvc" value="CHAT SERVICE (BE1 - Chí Trung)&#xa;Port: 5002 / 8080&#xa;• 1-1 &amp; Group Conversations&#xa;• SignalR Real-time (/hubs/chat)&#xa;• Typing, Read Receipt, Attachments&#xa;• gRPC Client -&gt; User Service&#xa;• Kafka Producer (chat.message_sent.v1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="340" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="forumSvc" value="FORUM SERVICE (BE2 - Minh Triết)&#xa;Port: 5003 / 8080&#xa;• Posts, Comments, Reactions&#xa;• Tags &amp; Content Reports&#xa;• SignalR ForumHub&#xa;• Kafka Producer (post.created.v1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="340" width="250" height="170" as="geometry" />
        </mxCell>
        <mxCell id="aiSvc" value="AI SERVICE (BE2 - Minh Triết)&#xa;Port: 5004 / 8080&#xa;• Alumni Mentorship Matching&#xa;• Career Q&amp;A Assistant&#xa;• Skill Recommendation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="940" y="340" width="250" height="170" as="geometry" />
        </mxCell>
        <mxCell id="adminSvc" value="ADMIN SERVICE (Lead - Quang Tâm)&#xa;Port: 5005 / 8080&#xa;• Dashboard Statistics&#xa;• Content Moderation &amp; Audit&#xa;• Internal REST -&gt; Suspend User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1220" y="340" width="260" height="170" as="geometry" />
